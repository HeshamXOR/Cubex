# Cubex developer environment variables (OPTIONAL).
# The recommended way to store credentials is the in-app secure store
# (OS-encrypted via Electron safeStorage). These env vars exist only for
# developer convenience and are read as a fallback when no stored secret exists.
#
# Never commit a real .env file. Cubex never logs these values.

# --- Cloud provider API keys (fallback only) ---
CUBEX_OPENAI_API_KEY=
CUBEX_ANTHROPIC_API_KEY=

# --- Optional: a default OpenAI-compatible endpoint for quick testing ---
CUBEX_OPENAI_COMPAT_BASE_URL=
CUBEX_OPENAI_COMPAT_API_KEY=

# --- Local runtimes ---
# Override the default Ollama endpoint (default: http://127.0.0.1:11434)
CUBEX_OLLAMA_BASE_URL=

# --- Data / models directories (default to the app data dir on the SSD) ---
CUBEX_DATA_DIR=
CUBEX_MODELS_DIR=

# --- Developer flags ---
# Set to 1 to enable verbose developer logging (secrets still redacted).
CUBEX_DEBUG=0
