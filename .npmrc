# Cubex uses npm. Two install-time defaults are set here:
#   fund=false   hides the funding notice that npm prints after an install.
#   audit=false  skips the automatic security audit request on install; run `npm audit` when you want a report.
# The postinstall script (electron-builder install-app-deps) rebuilds native modules such as
# better-sqlite3 for Electron's ABI, so a plain `npm install` is all that setup needs.
fund=false
audit=false
