# Cubex lives on the SSD; node_modules stays local to the project directory.
# Native modules (better-sqlite3) are rebuilt against Electron's ABI by the
# postinstall hook (electron-builder install-app-deps).
# Using npm (guaranteed present with Node) rather than pnpm: with the whole
# project on one SSD volume, pnpm's cross-project hardlink store adds little here.
fund=false
audit=false
